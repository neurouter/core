# Neurouter environment. Copy to `.env` (git-ignored). Outside production the server loads `.env`
# from the working directory or the repo root. Generate crypto values with:  npm run keys -- gen

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info
LOG_PRETTY=true
ORG_NAME=Neurouter (local)

# SQLite for local dev (no Docker); Postgres (with pgvector) for HA:
DATABASE_URL=sqlite:./data/neurouter.db
# DATABASE_URL=postgres://neurouter:neurouter@localhost:5432/neurouter
MIGRATE_ON_START=true

# Crypto (required in production; dev falls back to ephemeral values with a warning)
NEUROUTER_MASTER_KEYS=
NEUROUTER_ACTIVE_KEY_ID=
HASH_PEPPER=

# GitOps config (servers, environments). The example loads Petstore on the in-process mock.
NEUROUTER_CONFIG=./neurouter.example.yaml
NEUROUTER_CONFIG_MODE=hybrid

# Console sign-in: one-time local link (dev default) or a single OIDC provider
NEUROUTER_LOCAL_LINK=true
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# BOOTSTRAP_ADMIN_EMAIL=you@example.com

# Code mode executor: embedded (child process over a Unix socket) | local (in-process, dev only) | remote | off
NEUROUTER_EXECUTOR_MODE=embedded

# Search embeddings (local ONNX model; downloads on first use when EMBEDDINGS_ALLOW_REMOTE=true)
EMBEDDINGS_ENABLED=false

# Evals (BYOK). NEUROUTER_EVAL_LLM=stub runs the deterministic stub provider (no key, not a real model).
# Keys are per provider and each is optional; a model routes by its id (gpt-*/o<digit>* → OpenAI,
# claude-* → Anthropic, gemini-* → Gemini; or provider:model).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# NEUROUTER_EVAL_MODEL=gpt-6-luna
