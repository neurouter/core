{
  "name": "neurouter",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "Neurouter CLI: serve, validate, compile, mock and eval MCP servers generated from OpenAPI/GraphQL specs",
  "bin": {
    "neurouter": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@neurouter/shared": "0.1.0",
    "@neurouter/compiler": "0.1.0",
    "@neurouter/evals": "0.1.0",
    "@neurouter/server": "0.1.0",
    "commander": "15.1.0",
    "yaml": "2.9.1"
  }
}
