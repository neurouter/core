{
  "name": "neurouter",
  "version": "0.3.1",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openapi",
    "graphql",
    "ai-agents",
    "code-mode",
    "evals",
    "cli"
  ],
  "homepage": "https://github.com/neurouter/core#readme",
  "bugs": {
    "url": "https://github.com/neurouter/core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neurouter/core.git",
    "directory": "packages/cli"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "Neurouter CLI: serve, validate, compile, mock and eval MCP servers generated from OpenAPI/GraphQL specs",
  "bin": {
    "neurouter": "./dist/main.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "node ../../scripts/prepack.mjs --readme"
  },
  "dependencies": {
    "@neurouter/shared": "0.3.1",
    "@neurouter/compiler": "0.3.1",
    "@neurouter/evals": "0.3.1",
    "@neurouter/server": "0.3.1",
    "commander": "15.1.0",
    "yaml": "2.9.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
