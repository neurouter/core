{
  "name": "@neurouter/shared",
  "version": "0.3.0",
  "description": "Neurouter shared contract: API schemas, neurouter.yaml config schema, domain types",
  "keywords": [
    "mcp",
    "neurouter"
  ],
  "homepage": "https://github.com/neurouter/core#readme",
  "bugs": {
    "url": "https://github.com/neurouter/core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neurouter/core.git",
    "directory": "packages/shared"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "@neurouter/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "@neurouter/source": "./src/api/index.ts",
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./mcp": {
      "@neurouter/source": "./src/mcp/index.ts",
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./domain": {
      "@neurouter/source": "./src/domain/index.ts",
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./config": {
      "@neurouter/source": "./src/config/index.ts",
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./overlay": {
      "@neurouter/source": "./src/overlay/index.ts",
      "types": "./dist/overlay/index.d.ts",
      "default": "./dist/overlay/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
