{
  "name": "@neurouter/compiler",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "@neurouter/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@neurouter/shared": "0.1.0",
    "@scalar/openapi-parser": "0.29.28",
    "yaml": "2.9.1",
    "graphql": "17.1.0",
    "@faker-js/faker": "10.6.0",
    "canonicalize": "5.1.0"
  }
}
