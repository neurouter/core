{
  "name": "@neurouter/executor",
  "version": "0.2.1",
  "description": "Neurouter code-mode executor: sandboxed Python (Monty) for MCP code mode",
  "keywords": [
    "mcp",
    "code-mode",
    "sandbox",
    "neurouter"
  ],
  "homepage": "https://github.com/neurouter/core#readme",
  "bugs": {
    "url": "https://github.com/neurouter/core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neurouter/core.git",
    "directory": "apps/executor"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@neurouter/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "neurouter-executor": "./dist/main.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "dev": "tsx src/main.ts",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "dependencies": {
    "@pydantic/monty": "1.7.0",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
